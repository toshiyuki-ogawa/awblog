{
  "name": "awblog-ui",
  "version": "1.0.0",
  "description": "user interface for awblog.",
  "keywords": [
    "ui"
  ],
  "license": "Apache-2.0",
  "author": "Toshiyuki Ogawa",
  "type": "module",
  "browserslist": "baseline widely available",
  "source": "src/index.tsx",
  "targets": {
    "html": {
      "outputFormat": "global"
    }
  },
  "scripts": {
    "tsc-check": "tsc --noEmit",
    "html-dist": "parcel build --target=html --no-optimize",
    "make-index-map": "node tools/list-link.mjs -f index-entries.txt -e html >index-entries.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/google.accounts": "^0.0.18",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "ace-builds": "^1.44.0",
    "mime": "^4.1.0",
    "react-markdown": "^10.1.0"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1"
  }
}
